# URL canônica do site (produção) — usada em sitemap, robots e Open Graph
NEXT_PUBLIC_SITE_URL=https://seu-dominio.vercel.app

# Livro da platina (Fase 6). Gerar com: openssl rand -base64 48 (segredo) e openssl rand -base64 32 (admin).
# Sem RANKING_SECRET (≥ 32 caracteres) a API do livro responde 503 e o jogo segue funcionando.
RANKING_SECRET=
# Moderação manual: DELETE /api/ranking/<runId> com "Authorization: Bearer <ADMIN_TOKEN>" (≥ 24 caracteres).
ADMIN_TOKEN=
# Loja em memória do livro em produção fora da Vercel (ex.: `pnpm start` local). Use 1 para permitir; vazio = a API responde 503.
# Na Vercel é ignorado: sem a loja persistente (Fase 7) a API segue em 503.
RANKING_MEMORY_STORE=

# Livro persistente (Fase 7): a integração Upstash for Redis da Vercel cria KV_REST_API_URL e KV_REST_API_TOKEN
# (aceitamos também UPSTASH_REDIS_REST_URL/TOKEN). Com elas a API funciona na Vercel; sem elas segue a regra da memória acima.
# Em dev, `vercel env pull` traz as de Development. RANKING_SECRET e ADMIN_TOKEN valem por ambiente (Preview ≠ Development ≠ Production).
KV_REST_API_URL=
KV_REST_API_TOKEN=
